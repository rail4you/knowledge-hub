# 仿真实训 WASM 镜像（二进制不进 git，仅保留元信息）
etc/docker/wasm-mirrors/*/*
!etc/docker/wasm-mirrors/*/.gitkeep
!etc/docker/wasm-mirrors/*/.gitignore
!etc/docker/wasm-mirrors/*/mirror.json
!etc/docker/wasm-mirrors/*/README.md
!etc/docker/wasm-mirrors/.gitkeep
!etc/docker/wasm-mirrors/.gitignore
!etc/docker/wasm-mirrors/README.md

# Docker 引擎与数据库运行时数据（二进制、不稳定，不进 git）
