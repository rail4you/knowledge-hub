etc/docker/meilisearch_data/
etc/docker/uploads/             # 用户上传文件 + 转换缓存
etc/docker/.env                # 生产环境 secrets
etc/docker/certs/              # 自签名证书（生产用真证书）

# Unity 编辑器在仓库根误生成的缓存/临时文件（真正的 Unity 项目在 etc/docker/wasm-mirrors/）
