# ============================================================
# .env.example - KnowledgeHub 生产环境配置模板
# ============================================================
# 复制此文件为 .env 并修改相应值
#   cp .env.example .env
#   vim .env
#
# 部署:
#   ./deploy.sh up
# ============================================================

# ----------------------------------------------------------
# 公开访问地址（核心变量！浏览器实际访问的地址）
# 格式: https://IP 或 https://域名
# 不要带尾部斜杠，不要带端口号（走 443 端口）
# ----------------------------------------------------------
PUBLIC_URL=https://119.45.170.4

# ----------------------------------------------------------
# 服务器公网 IP（coturn TURN 中继使用，招聘直播 WebRTC 需要）
# ----------------------------------------------------------
PUBLIC_IP=your_public_ip

# ----------------------------------------------------------
# 招聘直播 WebRTC TURN 密钥（coturn static-auth-secret）
# 生成：openssl rand -base64 32
# 云安全组/防火墙需放行：UDP/TCP 3478、UDP/TCP 49160-49200
# ----------------------------------------------------------
TURN_SECRET=your_turn_secret_here

# ----------------------------------------------------------
# 数据库配置
# ----------------------------------------------------------
POSTGRES_PASSWORD=your_secure_password_here

# ----------------------------------------------------------
# Meilisearch 搜索引擎配置
# ----------------------------------------------------------
MEILISEARCH_MASTER_KEY=your_meili_master_key_here

# ----------------------------------------------------------
# Embedding API 配置
# ----------------------------------------------------------
EMBEDDING_API_KEY=your_embedding_api_key_here

# ----------------------------------------------------------
# OSS 阿里云对象存储（文件/图片上传必需）
# ----------------------------------------------------------
# OSS Endpoint，默认北京区域
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS AccessKey（阿里云 RAM 用户，需有 PutObject 权限）
OSS_ACCESS_KEY_ID=your_oss_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret_here
# OSS Bucket 名称
OSS_BUCKET_NAME=kg-edu
# OSS 上传路径前缀
OSS_UPLOAD_PATH=knowledgehub

# ----------------------------------------------------------
# 文件存储（本地磁盘）
# ----------------------------------------------------------
# 宿主机上传目录（bind mount 源）
STORAGE_HOST_DIR=./uploads
# 容器内存储根路径（bind mount 目标，必须与后端 Storage__RootPath 一致）
STORAGE_ROOT_PATH=/app/uploads

# ----------------------------------------------------------
# Qwen AI API 配置
# ----------------------------------------------------------
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ----------------------------------------------------------
# 安全配置
# ----------------------------------------------------------
JWT_CERTIFICATE_PASSWORD=your_jwt_cert_password_here
STRING_ENCRYPTION_PASSPHRASE=your_encryption_passphrase_here

# ----------------------------------------------------------
# Docker 镜像仓库
# ----------------------------------------------------------
REGISTRY=registry.cn-zhangjiakou.aliyuncs.com/myelixir
IMAGE_TAG=latest

# ----------------------------------------------------------
# LiteParse 文档解析服务
# ----------------------------------------------------------
# 镜像地址（由外部项目构建并推送到 ${REGISTRY}）
# 默认: ${REGISTRY}/knowledgehub-liteparse:${IMAGE_TAG}
# 可显式覆盖，如：ghcr.io/myorg/knowledgehub-liteparse:v1.2.3
LITEPARSE_IMAGE=
# 单次 /parse 请求超时（秒）。大 PDF + OCR 可能耗时较长
LITEPARSE_TIMEOUT=300
# 透传给 liteparse 的 OCR DPI（仅 PDF 扫描页生效）
LITEPARSE_DPI=300

# ----------------------------------------------------------
# Gotenberg 文档转 PDF 服务（Office 预览转换）
# ----------------------------------------------------------
# 镜像地址。默认: ${REGISTRY}/knowledgehub-gotenberg:${IMAGE_TAG}
# （自定义镜像含中文字体，构建见 etc/docker/Dockerfile.gotenberg）
# 如可接受中文渲染缺失，可覆盖为官方镜像: gotenberg/gotenberg:8
GOTENBERG_IMAGE=
