# 安全配置
JWT_CERTIFICATE_PASSWORD=402e4395-7ff7-40a8-9240-711ff07e487b
STRING_ENCRYPTION_PASSPHRASE=PKF8e9rIuzQvlIDm

# Docker 镜像仓库
