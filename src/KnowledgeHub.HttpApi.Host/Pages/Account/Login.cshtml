@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Web.Pages.Account
@model LoginModel
@inject IHtmlLocalizer<AccountResource> L
@{
    Layout = null;
    var returnUrl = Model.ReturnUrl;
    var returnUrlHash = Model.ReturnUrlHash;
}
<!DOCTYPE html>
<html lang="zh-Hans">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>易课通教学资源库 - 登录</title>
    <link rel="stylesheet" href="/libs/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/libs/font-awesome/css/font-awesome.min.css" />
    <style>
        :root {
            --kh-canvas: #f5f7fa;
            --kh-panel: #ffffff;
            --kh-ink: #1c2733;
            --kh-ink-2: #46586a;
            --kh-muted: #5f6f81;
            --kh-line: rgba(24,144,255,0.10);
            --kh-line-2: #e7edf5;
            --kh-accent: #1890ff;
            --kh-accent-deep: #0a6fce;
            --kh-accent-soft: rgba(24,144,255,0.10);
            --kh-accent-ghost: rgba(24,144,255,0.06);
            --kh-r-shell: 16px;
            --kh-r-control: 10px;
            --kh-shadow-card: 0 1px 2px rgba(14,27,46,0.04), 0 10px 30px -12px rgba(24,144,255,0.14), 0 22px 48px -30px rgba(14,27,46,0.18);
        }
        * { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; }
        body {
            font-family: "PingFang SC","Source Han Sans SC","Noto Sans SC","Microsoft YaHei",-apple-system,"Segoe UI",Roboto,sans-serif;
            background: var(--kh-canvas);
            color: var(--kh-ink);
            -webkit-font-smoothing: antialiased;
        }
        a { text-decoration: none; }

        /* ── Header — 与首页 PortalHome 顶栏统一（1152 紧凑） ── */
        .login-header {
            display: flex;
            align-items: center;
            gap: 24px;
            padding: 0 24px;
            height: 52px;
            border-bottom: 1px solid #eef1f6;
            background: #ffffff;
            flex-shrink: 0;
        }
        @@media (min-width: 1200px) {
            .login-header { padding: 0 calc((100% - 1152px) / 2); }
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: inherit;
        }
        .brand-mark {
            width: 34px; height: 34px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            background: #1e6ce8;
            color: #fff; font-size: 17px; font-weight: 700;
        }
        .brand-text { display: flex; align-items: baseline; gap: 6px; white-space: nowrap; line-height: 1.2; }
        .brand-text strong { font-size: 16px; font-weight: 700; color: #1f2d3d; letter-spacing: -0.3px; }
        .brand-text span { font-size: 12px; font-weight: 500; color: #8a93a6; }
        .header-nav {
            display: flex; align-items: center; gap: 2px; margin-left: 8px; flex: 1;
        }
        .header-nav a {
            padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 500;
            color: #5b6573; transition: color 0.15s, background 0.15s;
        }
        .header-nav a:hover { color: #1e6ce8; background: #eef4ff; }
        .header-nav a.active { color: #1e6ce8; font-weight: 600; }
        .header-right { display: flex; align-items: center; gap: 14px; }

        /* ── Page ── */
        .login-page {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: var(--kh-canvas);
        }
        .login-body {
            display: flex;
            flex: 1;
            min-height: 0;
            max-width: 1152px;
            width: 100%;
            margin: 0 auto;
            padding: 16px 0 16px;
            gap: 12px;
            background: var(--kh-canvas);
            box-sizing: border-box;
        }
        /* Left — 修饰背景图（占比 40%，居中，适度留白） */
        .login-left {
            flex: 4;
            border-radius: 12px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            padding: 32px 28px;
            background:
                linear-gradient(rgba(13,27,48,0.82), rgba(13,27,48,0.92)),
                url('/images/intro-bg_001.jpg') center/cover no-repeat,
                linear-gradient(135deg, #0d1b30 0%, #13233a 40%, #1a3a5c 100%);
            background-blend-mode: normal, normal, normal;
        }
        .login-left::before {
            content: '';
            position: absolute; inset: 0;
            background: url('/assets/images/login/login-bg-img-light.svg') center/cover no-repeat;
            opacity: 0.07;
            pointer-events: none;
        }
        .login-left::after {
            content: '';
            position: absolute;
            top: -80px; right: -80px;
            width: 320px; height: 320px; border-radius: 50%;
            background: radial-gradient(circle, rgba(24,144,255,0.18) 0%, transparent 70%);
            pointer-events: none;
        }
        .left-inner { position: relative; z-index: 1; max-width: 440px; }
        .left-title { font-size: 28px; font-weight: 800; color: #fff; margin: 0 0 8px; line-height: 1.15; }
        .left-title span { color: #7ec8ff; }
        .left-subtitle { font-size: 13.5px; color: rgba(255,255,255,0.88); margin: 0 0 20px; line-height: 1.6; }
        .feature-list { display: flex; flex-direction: column; gap: 10px; }
        .feature-item { display: flex; align-items: flex-start; gap: 14px; }
        /* 功能图标不显示：仅保留文字 */
        .feature-icon { display: none; }
        .feature-text h3 { font-size: 14px; font-weight: 600; color: #fff; margin: 0 0 2px; }
        .feature-text p { font-size: 13px; color: rgba(255,255,255,0.68); margin: 0; line-height: 1.4; }
        .left-quote {
            margin-top: 24px;
            padding: 14px 18px;
            border-left: 3px solid rgba(126,200,255,0.5);
            background: rgba(255,255,255,0.06);
            border-radius: 0 8px 8px 0;
        }
        .left-quote p { margin: 0 0 4px; font-size: 13.5px; font-weight: 600; color: #fff; font-style: italic; }
        .left-quote span { font-size: 11px; color: rgba(255,255,255,0.6); }
        .left-stats {
            display: flex; align-items: center; gap: 24px;
            margin-top: 36px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.12);
        }
        .left-stats .stat { display: flex; flex-direction: column; gap: 2px; }
        .left-stats .stat strong { font-size: 22px; font-weight: 800; color: #fff; line-height: 1; }
        .left-stats .stat span { font-size: 11px; color: rgba(255,255,255,0.6); letter-spacing: 0.04em; }
        .left-stats .stat-divider { width: 1px; height: 32px; background: rgba(255,255,255,0.12); }

        /* Right — 表单（占比 60%，居中） */
        .login-right {
            flex: 6;
            display: flex; align-items: center; justify-content: center;
            position: relative; overflow: hidden;
            border-radius: 12px; background: #ffffff;
            border: 1px solid rgba(24,144,255,0.10); box-shadow: 0 1px 2px rgba(14,27,46,0.04);
            padding: 28px 28px;
        }
        .login-right::before {
            content: ''; position: absolute; right: -30px; bottom: -20px;
            width: 420px; height: 340px;
            background: url('/assets/images/home/resource-library-hero.png') center/contain no-repeat;
            opacity: 0.05; pointer-events: none;
        }
        .login-right::after {
            content: ''; position: absolute; inset: 0;
            background: url('/assets/images/login/login-bg-img-light.svg') center/cover no-repeat;
            opacity: 0.025; pointer-events: none;
        }
        .login-card { width: 100%; max-width: 440px; position: relative; z-index: 1; }
        .form-title { font-size: 20px; font-weight: 700; color: var(--kh-ink); margin: 0 0 4px; }
        .form-subtitle { font-size: 12.5px; color: var(--kh-muted); margin: 0 0 16px; }
        .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px; }
        .form-group label { font-size: 12.5px; font-weight: 500; color: var(--kh-ink-2); display: flex; align-items: center; gap: 6px; }
        .form-group label i { color: var(--kh-muted); font-size: 12px; }
        .form-input {
            width: 100%; padding: 9px 12px;
            border: 1px solid var(--kh-line-2); border-radius: var(--kh-r-control);
            font-size: 13.5px; color: var(--kh-ink); background: #fbfcfe;
            outline: none; transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        }
        .form-input::placeholder { color: #9aa9ba; }
        .form-input:focus { border-color: var(--kh-accent); background: #fff; box-shadow: 0 0 0 3px var(--kh-accent-soft); }
        .password-wrapper { position: relative; }
        .password-wrapper .form-input { padding-right: 42px; }
        .toggle-password {
            position: absolute; right: 1px; top: 1px; bottom: 1px; width: 40px;
            border: none; background: none; color: #9ca3af; cursor: pointer;
            display: flex; align-items: center; justify-content: center; border-radius: 0 9px 9px 0;
        }
        .form-options { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
        .remember-me { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--kh-muted); cursor: pointer; }
        .remember-me input[type='checkbox'] { width: 16px; height: 16px; accent-color: var(--kh-accent); }
        .login-btn {
            width: 100%; padding: 10px; border: none; border-radius: var(--kh-r-control);
            background: var(--kh-accent); color: #fff; font-size: 14px; font-weight: 600;
            cursor: pointer; transition: background 0.15s; box-shadow: 0 8px 18px -8px rgba(24,144,255,0.55);
        }
        .login-btn:hover { background: var(--kh-accent-deep); }
        .tenant-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
        .tenant-tab {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 14px; border-radius: 999px; border: 1px solid var(--kh-line-2); background: #fff;
            color: var(--kh-ink-2); font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.15s;
        }
        .tenant-tab:hover { border-color: var(--kh-accent); color: var(--kh-accent); background: var(--kh-accent-ghost); }
        .tenant-tab.active { border-color: var(--kh-accent); background: var(--kh-accent); color: #fff; }
        .current-tenant-hint { font-size: 12px; color: var(--kh-muted); margin-top: 6px; }
        .current-tenant-hint strong { color: var(--kh-accent); font-weight: 600; }
        .current-tenant-hint.muted { color: #9aa9ba; }
        .alert { border-radius: 10px; font-size: 13px; }
        .card-foot {
            display: flex; align-items: center; justify-content: space-between;
            margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--kh-line-2);
            font-size: 11.5px; color: var(--kh-muted);
        }
        .card-foot a { color: var(--kh-accent); text-decoration: none; }
        .card-foot a:hover { text-decoration: underline; }

        /* ── Footer — 与首页一致 ── */
        .footer { background: #1f2a44; color: rgba(255,255,255,0.7); padding: 28px 0 0; margin-top: 16px; }
        .footer__inner { max-width: 1152px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1.4fr 2fr; gap: 40px; }
        .footer__brand-top { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
        .footer__brand-top strong { display: block; font-size: 17px; font-weight: 700; color: #fff; }
        .footer__brand-top p { margin: 2px 0 0; font-size: 12px; color: rgba(255,255,255,0.55); }
        .footer .brand__mark--lg { background: rgba(255,255,255,0.1); width: 44px; height: 44px; font-size: 22px; border-radius: 11px; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; }
        .footer__tagline { margin: 10px 0 0; font-size: 12px; line-height: 1.55; color: rgba(255,255,255,0.5); max-width: 360px; }
        .footer__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
        .footer__col h5 { font-size: 13px; font-weight: 600; color: #fff; margin: 0 0 12px; }
        .footer__col a { display: block; font-size: 12px; color: rgba(255,255,255,0.55); text-decoration: none; margin-bottom: 8px; }
        .footer__col a:hover { color: #fff; }
        .footer__copy { margin-top: 24px; padding: 14px 24px; text-align: center; font-size: 11px; color: rgba(255,255,255,0.4); border-top: 1px solid rgba(255,255,255,0.08); max-width: 1152px; margin-left: auto; margin-right: auto; }
        @@media (max-width: 860px) {
            .footer__inner { grid-template-columns: 1fr; gap: 20px; padding: 0 16px; }
            .footer__grid { grid-template-columns: 1fr 1fr; }
        }

        @@media (max-width: 960px) {
            .header-nav { display: none; }
            .login-body { flex-direction: column; overflow-y: auto; padding: 12px 16px; gap: 12px; max-width: none; margin: 0; }
            .login-left { min-height: 240px; padding: 20px 20px; }
            .left-title { font-size: 22px; }
            .login-right { flex: none; width: 100%; padding: 20px 20px; }
        }
        @@media (max-width: 640px) {
            .login-header { padding: 0 16px; height: 52px; }
        }
    </style>
</head>
<body>
<div class="login-page">
    <header class="login-header">
        <a href="/" class="brand">
            <span class="brand-mark">易</span>
            <span class="brand-text"><strong>易课通</strong> <span>教学资源库</span></span>
        </a>
        <nav class="header-nav">
            <a href="/" class="active">首页</a>
            <a href="/student/courses">课程中心</a>
            <a href="/student/resources">资源库</a>
            <a href="/student/micro-majors">微专业</a>
            <a href="/student/practicums">实训</a>
            <a href="/student/employment/jobs">就业</a>
        </nav>
        <div class="header-right">
            <a href="/" style="font-size:13px;color:#5b6573;display:inline-flex;align-items:center;gap:6px;"><i class="fa fa-home"></i> 返回首页</a>
        </div>
    </header>

    <div class="login-body">
        <div class="login-left">
            <div class="left-inner">
                <h1 class="left-title">易课通<br /><span>教学资源库</span></h1>
                <p class="left-subtitle">集成 AI 技术的新一代知识管理系统，为教育机构提供全方位的数字化教学支持</p>
                <div class="feature-list">
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fa fa-folder-open"></i></div>
                        <div class="feature-text"><h3>资源管理</h3><p>上传管理教学资源，支持多种文档格式</p></div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fa fa-search"></i></div>
                        <div class="feature-text"><h3>智能搜索</h3><p>基于 AI 的全文搜索，快速定位知识内容</p></div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fa fa-comments"></i></div>
                        <div class="feature-text"><h3>AI 助手</h3><p>智能对话问答，辅助学习与知识探索</p></div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fa fa-book"></i></div>
                        <div class="feature-text"><h3>课程学习</h3><p>系统化课程管理，跟踪学习进度</p></div>
                    </div>
                </div>
                <div class="left-quote">
                    <p>“让优质教育资源触手可及”</p>
                </div>
            </div>
        </div>

        <div class="login-right">
            <div class="login-card">
                <div class="card-head">
                    <h2 class="form-title">@L["Login"]</h2>
                    <p class="form-subtitle">欢迎回来，请登录您的账号</p>
                </div>

                @if (!Model.EnableLocalLogin && !Model.VisibleExternalProviders.Any())
                {
                    <div class="alert alert-warning">
                        <strong>@L["InvalidLoginRequest"]</strong>
                        @L["ThereAreNoLoginSchemesConfiguredForThisClient"]
                    </div>
                }
                else
                {
                    @if (Model.EnableLocalLogin)
                    {
                        <form method="post">
                            <input type="hidden" asp-for="ReturnUrl" />
                            <input type="hidden" asp-for="ReturnUrlHash" />
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-group">
                                <label><i class="fa fa-building"></i> 选择租户</label>
                                <div id="tenantTabs" class="tenant-tabs">
                                    <button type="button" class="tenant-tab active" data-tenant-id="" onclick="selectTenant('', '')"><i class="fa fa-home"></i> 宿主</button>
                                </div>
                                <div id="currentTenantHint" class="current-tenant-hint muted">当前以宿主身份登录</div>
                            </div>

                            <div class="form-group">
                                <label asp-for="LoginInput.UserNameOrEmailAddress"></label>
                                <input asp-for="LoginInput.UserNameOrEmailAddress" class="form-input" placeholder="@L["UserNameOrEmailAddress"]" autofocus />
                                <span asp-validation-for="LoginInput.UserNameOrEmailAddress" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="LoginInput.Password"></label>
                                <div class="password-wrapper">
                                    <input asp-for="LoginInput.Password" type="password" class="form-input" id="BackendPassword" placeholder="@L["Password"]" />
                                    <button type="button" class="toggle-password" onclick="var i=document.getElementById('BackendPassword'); i.type=i.type==='password'?'text':'password'; this.querySelector('i').classList.toggle('fa-eye'); this.querySelector('i').classList.toggle('fa-eye-slash');">
                                        <i class="fa fa-eye-slash"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="LoginInput.Password" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <div class="form-options">
                                <label class="remember-me">
                                    <input asp-for="LoginInput.RememberMe" />
                                    <span>@L["RememberMe"]</span>
                                </label>
                                <a href="@Url.Page("./ForgotPassword", new {returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash})" style="font-size:13px;color:var(--kh-accent);">@L["ForgotPassword"]</a>
                            </div>

                            <button type="submit" name="Action" value="Login" class="login-btn">@L["Login"]</button>
                            @if (Model.ShowCancelButton)
                            {
                                <button type="submit" name="Action" value="Cancel" class="btn btn-secondary w-100 mt-2">@L["Cancel"]</button>
                            }
                        </form>
                    }

                    @if (Model.VisibleExternalProviders.Any())
                    {
                        <div class="mt-3">
                            <h6 style="font-size:13px;color:var(--kh-muted);">@L["OrLoginWith"]</h6>
                            <form asp-page="./Login" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" asp-route-returnUrlHash="@Model.ReturnUrlHash" method="post">
                                @foreach (var provider in Model.VisibleExternalProviders)
                                {
                                    <button type="submit" class="btn btn-outline-primary m-1" name="provider" value="@provider.AuthenticationScheme">@provider.DisplayName</button>
                                }
                            </form>
                        </div>
                    }
                }

            </div>
        </div>
    </div>
    <footer class="footer">
        <div class="footer__inner">
            <div class="footer__brand">
                <div class="footer__brand-top">
                    <span class="brand__mark brand__mark--lg">易</span>
                    <div>
                        <strong>易课通 · 资源库</strong>
                        <p>教学资源库</p>
                    </div>
                </div>
                <p class="footer__tagline">汇聚课程、资源、实训，服务院校教学</p>
            </div>
            <div class="footer__grid">
                <div class="footer__col">
                    <h5>学习中心</h5>
                    <a href="/student/courses">课程中心</a>
                    <a href="/student/resources">资源库</a>
                    <a href="/student/micro-majors">微专业</a>
                    <a href="/student/practicums">实训项目</a>
                </div>
                <div class="footer__col">
                    <h5>智能应用</h5>
                    <a href="/ai/chat">AI 助手</a>
                    <a href="/ai/lesson-plan">智能备课</a>
                    <a href="/search">智能搜索</a>
                </div>
                <div class="footer__col">
                    <h5>关于</h5>
                    <a href="/">平台介绍</a>
                    <a href="/">帮助中心</a>
                    <a href="/">联系我们</a>
                </div>
            </div>
        </div>
        <div class="footer__copy">&copy; 2026 易课通 · 资源库</div>
    </footer>
</div>
<script>
(function() {
    function getTenantCookie() {
        var m = document.cookie.match(/(?:^|; )__tenant=([^;]*)/);
        return m ? decodeURIComponent(m[1]) : null;
    }
    function updateHint(html, isMuted) {
        var el = document.getElementById('currentTenantHint');
        if (!el) return;
        el.innerHTML = html;
        el.className = isMuted ? 'current-tenant-hint muted' : 'current-tenant-hint';
    }
    function setActiveTab(tenantId) {
        var tabs = document.querySelectorAll('#tenantTabs .tenant-tab');
        tabs.forEach(function(btn) {
            btn.classList.toggle('active', btn.getAttribute('data-tenant-id') === (tenantId || ''));
        });
    }
    window.selectTenant = function(id, name) {
        if (!id) { clearTenant(); return; }
        document.cookie = '__tenant=' + encodeURIComponent(id) + '; path=/; SameSite=Lax';
        setActiveTab(id);
        updateHint('当前租户：<strong>' + name + '</strong>', false);
    };
    window.clearTenant = function() {
        document.cookie = '__tenant=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
        setActiveTab('');
        updateHint('当前以宿主身份登录', true);
    };
    document.addEventListener('DOMContentLoaded', function() {
        // 加载租户列表渲染为 Tab
        fetch('/api/public/tenants', { headers: { 'accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .then(function(list) {
                if (!Array.isArray(list)) return;
                var container = document.getElementById('tenantTabs');
                list.forEach(function(t) {
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'tenant-tab';
                    btn.setAttribute('data-tenant-id', t.id);
                    btn.innerHTML = '<i class="fa fa-bank"></i> ' + t.name;
                    btn.onclick = function() { selectTenant(t.id, t.name); };
                    container.appendChild(btn);
                });
                var currentId = getTenantCookie();
                if (currentId) setActiveTab(currentId);
            })
            .catch(function() {});
        var tenantId = getTenantCookie();
        if (!tenantId) return;
        fetch('/api/abp/multi-tenancy/tenants/by-id/' + encodeURIComponent(tenantId), { headers: { 'accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.success && data.name) {
                    setActiveTab(tenantId);
                    updateHint('当前租户：<strong>' + data.name + '</strong>', false);
                } else {
                    setActiveTab(tenantId);
                    updateHint('当前租户ID：<strong>' + tenantId + '</strong>', false);
                }
            })
            .catch(function() {
                setActiveTab(tenantId);
                updateHint('当前租户ID：<strong>' + tenantId + '</strong>', false);
            });
    });
})();
</script>
</body>
</html>
