@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Web.Pages.Account
@model LoginModel
@inject IHtmlLocalizer<AccountResource> L
@{
    Layout = null;
    var returnUrl = Model.ReturnUrl;
    var returnUrlHash = Model.ReturnUrlHash;
    // 系统管理员专用通道：仅通过隐藏网址 /Account/Login?host=true 进入，
    // 页面上不显示任何入口。普通登录页此值为 false。
    // Angular /admin-login 经 OAuth 跳转到此处时 query 会丢失，改由 __host_login
    // 标记 cookie 透传（Angular 宿主页写入、普通页清除；仅无租户 cookie 时生效，
    // 因此租户流程不受陈旧标记影响，登录失败重渲也能保持宿主模式）。
    var hostQuery = Request.Query["host"].ToString();
    var hostMode = hostQuery == "true" || hostQuery == "1"
        || (Request.Cookies["__host_login"] == "1" && string.IsNullOrEmpty(Request.Cookies["__tenant"]));
}
<!DOCTYPE html>
<html lang="zh-Hans">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>登录 · 易课通教学资源库</title>
    <link rel="stylesheet" href="/libs/bootstrap/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        /* 配色取自应用主题：深海军蓝品牌区 + 主题蓝点缀，排版布局参考登录原型页 */
        :root{
            --ink: #13233a;
            --ink-deep: #0d1b30;
            --paper: #f5f7fa;
            --paper-card: #ffffff;
            --gold: #1890ff;
            --gold-light: #7ec8ff;
            --gold-soft: rgba(24,144,255,0.14);
            --text-muted: #5f6f81;
            --text-muted-on-ink: rgba(255,255,255,0.62);
            --border: #e7edf5;
            --danger: #e5484d;
            --radius: 10px;
            --shadow-card: 0 20px 50px -25px rgba(13,27,48,0.35);
        }

        *{ box-sizing: border-box; }

        html,body{
            margin:0;
            padding:0;
            min-height:100%;
            background: var(--paper);
            font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", -apple-system, "Segoe UI", sans-serif;
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
        }

        @@media (prefers-reduced-motion: reduce){
            *{ transition: none !important; animation: none !important; }
        }

        /* 主体容器：与首页一致，两侧各留 80px（平板 40px / 手机 20px），两栏带边框、中间留白 */
        .screen{
            display:flex;
            gap:24px;
            width:min(100%, 1760px);
            margin:0 auto;
            box-sizing:border-box;
            padding:24px 80px 48px;
            min-height:calc(100vh - 56px);
        }

        /* ---------- header ---------- */
        .topbar{
            display:flex;
            align-items:center;
            gap:24px;
            padding:0 80px;
            height:56px;
            background:var(--paper-card);
            border-bottom:1px solid var(--border);
            position:sticky;
            top:0;
            z-index:50;
        }
        .topbar .brand{
            display:flex;
            align-items:center;
            gap:10px;
            text-decoration:none;
            color:inherit;
            flex-shrink:0;
        }
        .topbar .brand-name{
            font-family:"Noto Serif SC", "Songti SC", serif;
            font-weight:700;
            font-size:1.05rem;
            color:var(--ink);
            white-space:nowrap;
        }
        .topbar .brand-sub{
            font-size:0.72rem;
            color:var(--text-muted);
            white-space:nowrap;
        }
        .topbar nav{
            display:flex;
            align-items:center;
            gap:2rem;
            margin:0 0 0 8px;
            flex:1;
        }
        .topbar nav a{
            padding:0.4rem 0;
            position:relative;
            font-size:0.92rem;
            font-weight:500;
            color:var(--text-muted);
            text-decoration:none;
            transition:color 0.15s;
            white-space:nowrap;
        }
        .topbar nav a:hover{ color:var(--ink); }
        .topbar nav a.active{ color:var(--ink); }
        .topbar nav a.active::after{
            content:"";
            position:absolute;
            left:0; right:0; bottom:-2px;
            height:2px;
            background:var(--gold);
        }
        .topbar .topbar-end{
            display:flex;
            align-items:center;
            gap:10px;
            flex-shrink:0;
        }
        .topbar .home-link{
            font-size:0.83rem;
            color:var(--text-muted);
            text-decoration:none;
            display:inline-flex;
            align-items:center;
            gap:6px;
        }
        .topbar .home-link:hover{ color:var(--gold); }

        /* ---------- footer ---------- */
        .site-footer{
            background:#0b1626;
            border-top:1px solid rgba(124,196,255,0.16);
            color:rgba(255,255,255,0.7);
            padding:28px 2rem 0;
        }
        .site-footer__inner{
            max-width:1200px;
            margin:0 auto;
            display:grid;
            grid-template-columns:1.4fr 2fr;
            gap:40px;
        }
        .site-footer__brand-top{ display:flex; align-items:center; gap:12px; margin-bottom:10px; }
        .site-footer__brand-top strong{ display:block; font-size:1.05rem; font-weight:700; color:#fff; font-family:"Noto Serif SC", "Songti SC", serif; }
        .site-footer__brand-top p{ margin:2px 0 0; font-size:0.75rem; color:rgba(255,255,255,0.55); }
        .site-footer__tagline{ margin:10px 0 0; font-size:0.75rem; line-height:1.55; color:rgba(255,255,255,0.5); max-width:360px; }
        .site-footer__grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:28px; }
        .site-footer__grid h5{ font-size:0.82rem; font-weight:600; color:#fff; margin:0 0 12px; }
        .site-footer__grid a{ display:block; font-size:0.75rem; color:rgba(255,255,255,0.55); text-decoration:none; margin-bottom:8px; }
        .site-footer__grid a:hover{ color:#fff; }
        .site-footer__copy{
            margin:24px auto 0;
            max-width:1200px;
            padding:14px 0;
            text-align:center;
            font-size:0.7rem;
            color:rgba(255,255,255,0.4);
            border-top:1px solid rgba(255,255,255,0.08);
        }

        /* ---------- LEFT: brand panel ---------- */
        .brand-panel{
            position:relative;
            flex: 0 0 44%;
            background: linear-gradient(160deg, var(--ink) 0%, var(--ink-deep) 100%);
            color: #fff;
            padding: 2.5rem 3.5rem;
            display:flex;
            flex-direction:column;
            justify-content:flex-start;
            overflow:hidden;
            border:1px solid var(--border);
            border-radius:14px;
        }

        .brand-panel::before{
            content:"";
            position:absolute;
            inset:0;
            background-image:
                radial-gradient(1px 1px at 20% 30%, rgba(126,200,255,0.35) 0, transparent 60%),
                radial-gradient(1px 1px at 70% 15%, rgba(126,200,255,0.25) 0, transparent 60%),
                radial-gradient(1px 1px at 85% 65%, rgba(126,200,255,0.3) 0, transparent 60%),
                radial-gradient(1px 1px at 40% 80%, rgba(126,200,255,0.2) 0, transparent 60%);
            pointer-events:none;
        }

        .brand-mark{
            display:flex;
            align-items:center;
            gap:0.65rem;
            position:relative;
            z-index:1;
        }

        .brand-mark svg{ flex-shrink:0; }

        .brand-mark span{
            font-family:"Noto Serif SC", "Songti SC", serif;
            font-weight:600;
            font-size:1.15rem;
            letter-spacing:0.02em;
        }

        .brand-hero{ position:relative; z-index:1; margin-top:1.6rem; }

        .brand-hero h1{
            font-family:"Noto Serif SC", "Songti SC", serif;
            font-weight:700;
            font-size: clamp(2rem, 3.4vw, 2.6rem);
            line-height:1.35;
            margin: 0 0 0.6rem;
            color:#fff;
        }

        .brand-hero p.lede{
            font-size:0.98rem;
            line-height:1.7;
            color: var(--text-muted-on-ink);
            max-width: 30ch;
            margin:0;
        }

        .gold-rule{
            width:44px;
            height:2px;
            background: var(--gold);
            margin: 1.2rem 0 1.1rem;
            position:relative;
            z-index:1;
        }

        .feature-list{
            list-style:none;
            margin:0;
            padding:0;
            position:relative;
            z-index:1;
        }

        .feature-list li{
            display:flex;
            gap:0.85rem;
            padding: 0.6rem 0;
            border-top:1px solid rgba(255,255,255,0.1);
        }
        .feature-list li:first-child{ border-top:none; }

        .feature-list .dot{
            width:6px;
            height:6px;
            border-radius:50%;
            background: var(--gold-light);
            margin-top:0.55rem;
            flex-shrink:0;
        }

        .feature-list h3{
            font-size:0.95rem;
            font-weight:600;
            margin:0 0 0.25rem;
            color:#fff;
        }

        .feature-list p{
            font-size:0.85rem;
            line-height:1.6;
            color: var(--text-muted-on-ink);
            margin:0;
        }

        /* ---------- RIGHT: form panel ---------- */
        .form-panel{
            flex:1;
            display:flex;
            align-items:center;
            justify-content:center;
            padding: 3rem 2rem;
            background: var(--paper-card);
            border:1px solid var(--border);
            border-radius:14px;
        }

        .form-card{
            width:100%;
            max-width: 392px;
            transform: translateY(-40px);
        }

        .form-card h2{
            font-family:"Noto Serif SC", "Songti SC", serif;
            font-weight:600;
            font-size:1.7rem;
            margin:0 0 0.45rem;
            color:var(--ink);
        }

        .form-card .sub{
            font-size:0.9rem;
            color: var(--text-muted);
            margin:0 0 2.1rem;
        }

        .field{ margin-bottom:1.3rem; }

        .field label{
            display:block;
            font-size:0.82rem;
            font-weight:500;
            color: var(--ink);
            margin-bottom:0.5rem;
        }

        .field input[type="text"],
        .field input[type="password"],
        .field input[type="email"]{
            width:100%;
            padding:0.72rem 0.9rem;
            font-size:0.92rem;
            font-family:inherit;
            color: var(--ink);
            background: var(--paper-card);
            border:1px solid var(--border);
            border-radius: var(--radius);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .field input::placeholder{ color:#9aa9ba; }

        .field input:focus{
            outline:none;
            border-color: var(--gold);
            box-shadow: 0 0 0 3px var(--gold-soft);
        }

        .password-wrap{ position:relative; }
        .password-wrap input{ padding-right: 2.6rem; }

        .toggle-visibility{
            position:absolute;
            right:0.6rem;
            top:50%;
            transform:translateY(-50%);
            background:none;
            border:none;
            padding:0.35rem;
            cursor:pointer;
            color: var(--text-muted);
            display:flex;
            border-radius:6px;
        }
        .toggle-visibility:hover{ color: var(--ink); }
        .toggle-visibility:focus-visible{ outline:2px solid var(--gold); outline-offset:2px; }

        /* tenant select */
        .tenant-select{ position:relative; }

        .tenant-trigger{
            width:100%;
            display:flex;
            align-items:center;
            justify-content:space-between;
            padding:0.68rem 0.9rem;
            background: var(--paper-card);
            border:1px solid var(--border);
            border-radius: var(--radius);
            cursor:pointer;
            font-family:inherit;
            font-size:0.92rem;
            color: var(--ink);
        }

        .tenant-trigger:focus-visible{ outline:none; border-color:var(--gold); box-shadow:0 0 0 3px var(--gold-soft); }

        .tenant-trigger .current{ display:flex; align-items:center; gap:0.55rem; }

        .tenant-badge{
            width:22px; height:22px;
            border-radius:6px;
            background: var(--ink);
            color: var(--gold-light);
            font-size:0.72rem;
            font-weight:700;
            display:flex; align-items:center; justify-content:center;
            font-family:"Noto Serif SC", "Songti SC", serif;
            flex-shrink:0;
        }

        .tenant-trigger svg{ transition: transform 0.15s ease; color:var(--text-muted); flex-shrink:0; }
        .tenant-select.open .tenant-trigger svg{ transform: rotate(180deg); }

        .tenant-menu{
            position:absolute;
            left:0; right:0;
            top: calc(100% + 6px);
            background: var(--paper-card);
            border:1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-card);
            padding:0.35rem;
            z-index:20;
            display:none;
            max-height:220px;
            overflow-y:auto;
        }
        .tenant-select.open .tenant-menu{ display:block; }

        .tenant-option{
            display:flex;
            align-items:center;
            gap:0.6rem;
            width:100%;
            padding:0.55rem 0.6rem;
            border:none;
            background:none;
            text-align:left;
            font-family:inherit;
            font-size:0.88rem;
            color: var(--ink);
            border-radius:7px;
            cursor:pointer;
        }
        .tenant-option:hover{ background: var(--gold-soft); }
        .tenant-option.active{ font-weight:600; }
        .tenant-option .check{ margin-left:auto; color: var(--gold); opacity:0; }
        .tenant-option.active .check{ opacity:1; }

        .tenant-hint{
            font-size:0.83rem;
            color: var(--text-muted);
            margin-top:0.55rem;
        }

        .row-between{
            display:flex;
            align-items:center;
            justify-content:space-between;
            margin-bottom:1.7rem;
        }

        .remember{
            display:flex;
            align-items:center;
            gap:0.55rem;
            font-size:0.85rem;
            color: var(--text-muted);
            cursor:pointer;
            user-select:none;
            margin-bottom:0;
        }

        .remember input{
            appearance:none;
            -webkit-appearance:none;
            width:16px; height:16px;
            border:1.5px solid var(--border);
            border-radius:4px;
            display:grid;
            place-content:center;
            cursor:pointer;
            margin:0;
        }
        .remember input::before{
            content:"";
            width:9px; height:9px;
            transform:scale(0);
            border-radius:2px;
            background: var(--gold);
        }
        .remember input:checked::before{ transform:scale(1); }
        .remember input:focus-visible{ outline:2px solid var(--gold); outline-offset:2px; }

        .forgot{
            font-size:0.85rem;
            color: var(--ink);
            text-decoration:none;
            border-bottom:1px solid var(--gold);
        }
        .forgot:hover{ color: var(--gold); }

        .submit-btn{
            position:relative;
            width:100%;
            padding:0.85rem 1rem;
            background: var(--ink);
            color: #fff;
            border:none;
            border-radius: var(--radius);
            font-family:inherit;
            font-size:0.96rem;
            font-weight:600;
            letter-spacing:0.02em;
            cursor:pointer;
            transition: background 0.15s ease;
        }
        .submit-btn:hover{ background: var(--ink-deep); }
        .submit-btn:focus-visible{ outline:2px solid var(--gold); outline-offset:3px; }

        .helper-text{
            text-align:center;
            font-size:0.83rem;
            color: var(--text-muted);
            margin-top:1.5rem;
        }

        .channel-hint{
            font-size:0.83rem;
            color: var(--text-muted);
            margin-bottom:1.3rem;
        }

        .validation-summary{
            font-size:0.85rem;
            margin-bottom:1.1rem;
        }
        .validation-summary ul{ margin:0; padding-left:1.1rem; }

        /* ---------- responsive ---------- */
        @@media (max-width: 1247px){
            .topbar{ padding:0 40px; }
            .screen{ padding:20px 40px 40px; }
        }
        @@media (max-width: 900px){
            .topbar{ padding:0 1.25rem; gap:12px; }
            .topbar nav{ display:none; }
            .topbar .brand-sub{ display:none; }
            .site-footer{ padding:24px 1.5rem 0; }
            .site-footer__inner{ grid-template-columns:1fr; gap:20px; }
            .site-footer__grid{ grid-template-columns:1fr 1fr; }
            .screen{ flex-direction:column; padding:16px 20px 32px; }
            .brand-panel{
                flex:none;
                padding: 2.2rem 1.75rem;
            }
            .brand-hero{ margin-top:1.2rem; }
            .brand-hero h1{ font-size:1.5rem; }
            .brand-hero p.lede{ max-width:none; }
            .feature-list{ display:none; }
            .gold-rule{ margin: 1.5rem 0; }
            .form-panel{ padding: 2.4rem 1.5rem 3rem; }
        }
    </style>
</head>
<body>

<header class="topbar">
    <a href="/" class="brand">
        <svg width="26" height="26" viewBox="0 0 30 30" fill="none">
            <rect width="30" height="30" rx="8" fill="#13233A" stroke="#1890FF" stroke-width="1.2"/>
            <text x="15" y="21" text-anchor="middle" font-size="15" font-weight="700" fill="#7EC8FF" font-family="PingFang SC, Microsoft YaHei, sans-serif">易</text>
        </svg>
        <span class="brand-name">易课通</span>
        <span class="brand-sub">教学资源库</span>
    </a>
    <nav>
        <a href="/" class="active">首页</a>
        <a href="/student/courses">课程中心</a>
        <a href="/student/resources">资源库</a>
        <a href="/student/micro-majors">微专业</a>
        <a href="/student/practicums">实训</a>
        <a href="/student/employment/jobs">就业</a>
    </nav>
    <div class="topbar-end">
        <a href="/" class="home-link">返回首页</a>
    </div>
</header>

<div class="screen">

    <!-- LEFT: brand / value panel -->
    <div class="brand-panel">
        <div class="brand-mark">
            <svg width="30" height="30" viewBox="0 0 30 30" fill="none">
                <rect width="30" height="30" rx="8" fill="#13233A" stroke="#1890FF" stroke-width="1.2"/>
                <text x="15" y="21" text-anchor="middle" font-size="15" font-weight="700" fill="#7EC8FF" font-family="PingFang SC, Microsoft YaHei, sans-serif">易</text>
            </svg>
            <span>易课通</span>
        </div>

        <div class="brand-hero">
            <h1>教学资源库<br />为机构而生的知识底座</h1>
            <p class="lede">集成 AI 能力的新一代知识管理系统，帮助教育机构沉淀资源、加速教学与研发协同。</p>

            <div class="gold-rule"></div>

            <ul class="feature-list">
                <li>
                    <span class="dot"></span>
                    <div>
                        <h3>资源管理</h3>
                        <p>上传与管理教学资源，支持多种文档格式</p>
                    </div>
                </li>
                <li>
                    <span class="dot"></span>
                    <div>
                        <h3>智能搜索</h3>
                        <p>基于 AI 的全文搜索，快速定位知识内容</p>
                    </div>
                </li>
                <li>
                    <span class="dot"></span>
                    <div>
                        <h3>AI 助手</h3>
                        <p>智能对话问答，辅助学习与知识探索</p>
                    </div>
                </li>
                <li>
                    <span class="dot"></span>
                    <div>
                        <h3>课程学习</h3>
                        <p>系统化课程管理，跟踪学习进度</p>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <!-- RIGHT: login form -->
    <div class="form-panel">
        <div class="form-card">
            <h2>@L["Login"]</h2>
            @if (hostMode)
            {
                <p class="sub">系统管理员登录</p>
            }
            else
            {
                <p class="sub">欢迎回来，请登录您的账号</p>
            }

            @if (!Model.EnableLocalLogin && !Model.VisibleExternalProviders.Any())
            {
                <div class="alert alert-warning">
                    <strong>@L["InvalidLoginRequest"]</strong>
                    @L["ThereAreNoLoginSchemesConfiguredForThisClient"]
                </div>
            }
            else
            {
                @if (Model.EnableLocalLogin)
                {
                    <form method="post" id="localLoginForm" autocomplete="off">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <input type="hidden" asp-for="ReturnUrlHash" />
                        <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

                        @if (hostMode)
                        {
                            <div class="channel-hint">系统管理员专用通道</div>
                        }
                        else
                        {
                            <div class="field" id="tenantBlock">
                                <label id="tenant-label">机构</label>
                                <div class="tenant-select" id="tenantSelect">
                                    <button type="button" class="tenant-trigger" id="tenantTrigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="tenant-label">
                                        <span class="current">
                                            <span class="tenant-badge" id="tenantBadge">·</span>
                                            <span id="tenantCurrentName">正在加载机构列表…</span>
                                        </span>
                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </button>
                                    <div class="tenant-menu" role="listbox" id="tenantMenu"></div>
                                </div>
                                <div class="tenant-hint" id="tenantHint" style="display:none;"></div>
                            </div>
                            <div class="field" id="noTenantNotice" style="display:none;">
                                <div class="tenant-hint">当前暂无可用租户，请联系管理员分配后再登录</div>
                            </div>
                        }

                        <div id="loginFields">
                            <div class="field">
                                <label asp-for="LoginInput.UserNameOrEmailAddress"></label>
                                <input asp-for="LoginInput.UserNameOrEmailAddress" placeholder="@L["UserNameOrEmailAddress"]" autofocus />
                                <span asp-validation-for="LoginInput.UserNameOrEmailAddress" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <div class="field">
                                <label asp-for="LoginInput.Password"></label>
                                <div class="password-wrap">
                                    <input asp-for="LoginInput.Password" type="password" id="BackendPassword" placeholder="@L["Password"]" />
                                    <button type="button" class="toggle-visibility" id="toggleVisibility" aria-label="显示密码">
                                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" id="eyeIcon">
                                            <path d="M1.5 9S4 3.5 9 3.5 16.5 9 16.5 9 14 14.5 9 14.5 1.5 9 1.5 9z" stroke="currentColor" stroke-width="1.4"/>
                                            <circle cx="9" cy="9" r="2.4" stroke="currentColor" stroke-width="1.4"/>
                                        </svg>
                                    </button>
                                </div>
                                <span asp-validation-for="LoginInput.Password" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <div class="row-between">
                                <label class="remember">
                                    <input asp-for="LoginInput.RememberMe" />
                                    <span>@L["RememberMe"]</span>
                                </label>
                                <a href="@Url.Page("./ForgotPassword", new {returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash})" class="forgot">@L["ForgotPassword"]</a>
                            </div>

                            <button type="submit" name="Action" value="Login" class="submit-btn">@L["Login"]</button>
                            @if (Model.ShowCancelButton)
                            {
                                <button type="submit" name="Action" value="Cancel" class="btn btn-secondary w-100 mt-2">@L["Cancel"]</button>
                            }
                        </div>
                    </form>
                    @if (!hostMode)
                    {
                        <p class="helper-text">没有账号？请联系机构管理员开通</p>
                    }
                }

                @if (Model.VisibleExternalProviders.Any())
                {
                    <div class="mt-3">
                        <h6 style="font-size:13px;color:var(--text-muted);">@L["OrLoginWith"]</h6>
                        <form asp-page="./Login" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" asp-route-returnUrlHash="@Model.ReturnUrlHash" method="post">
                            @foreach (var provider in Model.VisibleExternalProviders)
                            {
                                <button type="submit" class="btn btn-outline-primary m-1" name="provider" value="@provider.AuthenticationScheme">@provider.DisplayName</button>
                            }
                        </form>
                    </div>
                }
            }
        </div>
    </div>

</div>

