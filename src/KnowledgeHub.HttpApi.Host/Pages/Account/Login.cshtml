<script>
(function() {
    var HOST_MODE = @(hostMode ? "true" : "false");
    function getTenantCookie() {
        var m = document.cookie.match(/(?:^|; )__tenant=([^;]*)/);
        return m ? decodeURIComponent(m[1]) : null;
    }
    function clearTenantCookie() {
        document.cookie = '__tenant=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
    }

    // 密码显隐切换
    var pwInput = document.getElementById('BackendPassword');
    var toggleBtn = document.getElementById('toggleVisibility');
    var eyeIcon = document.getElementById('eyeIcon');
    if (pwInput && toggleBtn) {
        toggleBtn.addEventListener('click', function() {
            var isPw = pwInput.type === 'password';
            pwInput.type = isPw ? 'text' : 'password';
            toggleBtn.setAttribute('aria-label', isPw ? '隐藏密码' : '显示密码');
            if (eyeIcon) eyeIcon.style.opacity = isPw ? '0.55' : '1';
        });
    }

    function showNoTenant() {
        var block = document.getElementById('tenantBlock');
        var notice = document.getElementById('noTenantNotice');
        var fields = document.getElementById('loginFields');
        if (block) block.style.display = 'none';
        if (notice) notice.style.display = '';
        if (fields) fields.style.display = 'none';
    }
    function showTenantHint(text) {
        var el = document.getElementById('tenantHint');
        if (!el) return;
        el.textContent = text;
        el.style.display = '';
    }

    // 机构下拉框
    var tenantSelect = document.getElementById('tenantSelect');
    var tenantTrigger = document.getElementById('tenantTrigger');
    var tenantMenu = document.getElementById('tenantMenu');
    var tenantBadge = document.getElementById('tenantBadge');
    var tenantCurrentName = document.getElementById('tenantCurrentName');

    function closeTenant() {
        if (!tenantSelect || !tenantTrigger) return;
        tenantSelect.classList.remove('open');
        tenantTrigger.setAttribute('aria-expanded', 'false');
    }

    function applyTenant(id, name) {
        if (!id) return;
        document.cookie = '__tenant=' + encodeURIComponent(id) + '; path=/; SameSite=Lax';
        if (tenantCurrentName) tenantCurrentName.textContent = name;
        if (tenantBadge) tenantBadge.textContent = name.charAt(0);
        if (tenantMenu) {
            tenantMenu.querySelectorAll('.tenant-option').forEach(function(o) {
                o.classList.toggle('active', o.getAttribute('data-id') === id);
            });
        }
    }
    window.selectTenant = applyTenant;

    function resolveTenantName(tenantId) {
        fetch('/api/abp/multi-tenancy/tenants/by-id/' + encodeURIComponent(tenantId), { headers: { 'accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.success && data.name) {
                    applyTenant(tenantId, data.name);
                } else {
                    applyTenant(tenantId, tenantId);
                }
            })
            .catch(function() {
                if (tenantCurrentName) tenantCurrentName.textContent = tenantId;
                if (tenantBadge) tenantBadge.textContent = tenantId.charAt(0);
            });
    }

    document.addEventListener('DOMContentLoaded', function() {
        if (HOST_MODE) {
            // 系统管理员专用通道：强制宿主上下文，不拉取租户列表
            clearTenantCookie();
            return;
        }
        if (!tenantSelect || !tenantMenu) return;
        if (tenantTrigger) {
            tenantTrigger.addEventListener('click', function(e) {
                e.stopPropagation();
                var willOpen = !tenantSelect.classList.contains('open');
                tenantSelect.classList.toggle('open', willOpen);
                tenantTrigger.setAttribute('aria-expanded', String(willOpen));
            });
        }
        document.addEventListener('click', closeTenant);
        document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeTenant(); });

        // 加载机构列表（仅真实租户；过滤后端返回的 Id 为空的占位项）
        fetch('/api/public/tenants', { headers: { 'accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .then(function(list) {
                if (!Array.isArray(list)) throw new Error('bad tenants');
                var realTenants = list.filter(function(t) { return t && t.id != null && t.name; });
                if (realTenants.length === 0) {
                    // 无租户：不提供登录界面，等管理员分配租户
                    clearTenantCookie();
                    showNoTenant();
                    return;
                }
                realTenants.forEach(function(t) {
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'tenant-option';
                    btn.setAttribute('data-id', t.id);
                    btn.setAttribute('role', 'option');
                    btn.innerHTML = '<span class="current"><span class="tenant-badge"></span></span><span class="opt-name"></span><span class="check">✓</span>';
                    btn.querySelector('.tenant-badge').textContent = t.name.charAt(0);
                    btn.querySelector('.opt-name').textContent = t.name;
                    btn.addEventListener('click', function() {
                        applyTenant(t.id, t.name);
                        closeTenant();
                    });
                    tenantMenu.appendChild(btn);
                });
                var currentId = getTenantCookie();
                var stillExists = currentId && realTenants.some(function(t) { return t.id === currentId; });
                if (!stillExists) {
                    // 无 cookie 或指向已不存在的租户：默认选中第一个，避免误以宿主身份登录
                    applyTenant(realTenants[0].id, realTenants[0].name);
                    return;
                }
                resolveTenantName(currentId);
            })
            .catch(function() {
                if (tenantCurrentName) tenantCurrentName.textContent = '请选择机构';
                showTenantHint('机构列表加载失败，请刷新页面重试');
            });
    });
})();
</script>
</body>
</html>
